---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"p"> {
  message: string;
}

const { message, class: className, ...rest } = Astro.props;
---

<p class:list={["empty-state", className]} {...rest}>
  {message}
</p>

<style>
  .empty-state {
    margin: 2.5rem 0;
    color: var(--muted);
    text-align: center;
    font-size: var(--font-size-base);
  }
</style>
