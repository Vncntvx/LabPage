<script is:inline>
  (() => {
    const root = document.documentElement;
    const media = matchMedia("(prefers-color-scheme: dark)");
    let preference = "system";
    try {
      const saved = localStorage.getItem("theme");
      if (["light", "dark", "system"].includes(saved)) preference = saved;
    } catch {}
    const apply = () => {
      const transitioning = root.dataset.theme !== undefined;
      if (transitioning) {
        root.classList.add("theme-transition");
        window.setTimeout(() => root.classList.remove("theme-transition"), 250);
      }
      root.dataset.themeSetting = preference;
      root.dataset.theme = preference === "system" ? (media.matches ? "dark" : "light") : preference;
      document.dispatchEvent(new Event("theme-change"));
    };
    apply();
    media.addEventListener("change", apply);
    window.addEventListener("storage", (event) => {
      if (event.key === "theme") {
        preference = ["light", "dark"].includes(event.newValue) ? event.newValue : "system";
        apply();
      }
    });
    document.addEventListener("theme-request", (event) => {
      const requested = event instanceof CustomEvent ? event.detail : "system";
      preference = ["light", "dark", "system"].includes(requested) ? requested : "system";
      try {
        localStorage.setItem("theme", preference);
      } catch {}
      apply();
    });
  })();
</script>
