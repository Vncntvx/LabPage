---
import { getCollection } from "astro:content";
import { flatNavEntries } from "../lib/nav";
import { localeUrl, strings, type Locale } from "../lib/i18n";
import BaseLayout from "../layouts/BaseLayout.astro";
import PageTitle from "./ui/PageTitle.astro";
import ChipButton from "./ui/ChipButton.astro";
import Icon from "./ui/Icon.astro";
import NotFoundLocale from "./NotFoundLocale.astro";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const copy = strings(locale).not_found;

/**
 * The outbound links a dead end offers. Derived from the nav model in
 * `src/lib/nav.ts` — the same ordering, the same visibility graph — so a page
 * that retires (drafted, or a dropdown with no reachable child) disappears here
 * too instead of offering a second dead link, and the two lists cannot drift
 * apart on ordering.
 *
 * The home page is excluded: it is the primary button above, and listing it
 * again would put the same destination twice on a page with nothing else on it.
 */
const allPages = await getCollection("pages");
const suggestions = flatNavEntries(allPages, locale).filter(({ path }) => path !== "/");
---

<BaseLayout locale={locale} title={copy.title} description={copy.description} path="/404/" switchPath="/" noindex>
  <NotFoundLocale slot="page-end" locale={locale} pages={allPages} />
  <div class="not-found">
    <span class="not-found-code" aria-hidden="true">
      {copy.code}
    </span>
    <div data-not-found-heading>
      <PageTitle title={copy.title} description={copy.description} locale={locale} />
    </div>
    <div class="not-found-actions">
      <ChipButton href={localeUrl(locale)} primary size="lg" data-home-link>
        <Icon name="chevron" class="not-found-home-icon" />
        <span data-not-found-home>{copy.home}</span>
      </ChipButton>
      <ChipButton type="button" size="lg" data-search-open>
        <Icon name="search" class="not-found-search-icon" />
        <span data-not-found-search>{copy.search}</span>
      </ChipButton>
    </div>
    {suggestions.length > 0 && (
      <nav class="not-found-suggestions" aria-label={copy.suggestions} data-not-found-suggestions>
        <h2 class="not-found-suggestions-title" data-not-found-suggestions-title>
          {copy.suggestions}
        </h2>
        <ul>
          {suggestions.map((suggestion) => (
            <li>
              <a href={localeUrl(locale, suggestion.path)} data-not-found-suggestion={suggestion.path}>
                {suggestion.title}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    )}
  </div>
</BaseLayout>

<style>
  .not-found {
    /* Centred rather than left-aligned: a dead end is not a document, so it has
       no reading measure to fill. */
    padding-block: 1.5rem 0.5rem;
    text-align: center;
  }

  /* The page title's own margin is `margin-bottom`, which would sit *between*
     the code and the heading once the code comes first in the flow. */
  .not-found :global(.page-title) {
    margin-bottom: 2rem;
  }

  /* `text-align: center` above is only inherited, and the document's `p` rule
     sets `justify` directly on the element — a direct declaration beats an
     inherited one, so the centred layout has to be reasserted on the paragraph
     itself. The description is one line, where justification would only stretch
     the word spacing. */
  .not-found :global(.page-title) :global(.page-description) {
    margin-bottom: 0;
    text-align: center;
  }

  .not-found-code {
    display: block;
    color: var(--accent-soft);
    font-family: var(--serif);
    font-size: clamp(4.5rem, 18vw, 8rem);
    font-weight: var(--font-weight-bold);
    line-height: 1;
    letter-spacing: -0.03em;
  }

  /* The 404 is a label, not an image: an assistive technology should not read a
     bare number where the heading already says "page not found". */
  .not-found :global(h1) {
    margin-top: 0.5rem;
  }

  .not-found-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    justify-content: center;
    margin-bottom: 2.75rem;
  }

  /* `ChipButton`'s default `rect` shape carries the site's standard control
     radius (`--radius-sm`), which is what the site's buttons use. The `pill`
     shape was wrong here: it derives its radius from `--pill-height`, and at
     this control's height that reads as a lozenge rather than a button. The
     height is 2.5rem rather than `lg`'s default 2.25rem because these two
     buttons are the page's only actions and read as the primary tier; the icon
     gap is the page's own. */
  .not-found-actions :global(.chip-button) {
    min-height: 2.5rem;
    gap: 0.45rem;
  }

  /* The chevron points down in the nav; rotated it reads as "back". */
  .not-found-home-icon {
    transform: rotate(90deg);
  }

  .not-found-suggestions-title {
    margin: 0 0 0.9rem;
    color: var(--muted);
    font-family: var(--sans);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-medium);
    line-height: var(--line-height-normal);
    text-align: center;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .not-found-suggestions ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    justify-content: center;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Each suggestion reads as a chip but stays a plain link: there is no action
     to submit, and a real anchor gives the browser its own affordances. */
  .not-found-suggestions a {
    display: inline-block;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--surface);
    padding: 0.3rem 0.7rem;
    color: var(--text);
    font-family: var(--sans);
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-medium);
    line-height: var(--line-height-snug);
    text-decoration: none;
  }

  .not-found-suggestions a:hover,
  .not-found-suggestions a:focus-visible {
    border-color: var(--accent);
    background: var(--accent-soft);
    color: var(--accent);
  }

  @media (max-width: 600px) {
    .not-found-actions {
      flex-direction: column;
      align-items: stretch;
    }
  }
</style>
