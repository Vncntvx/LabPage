  scholar: '<path d="M12 24a7 7 0 1 1 0-14 7 7 0 0 1 0 14zm0-24L0 9.5l4.838 3.94A8 8 0 0 1 12 9a8 8 0 0 1 7.162 4.44L24 9.5z" />',
  wechat:
    '<path d="M8.691 2.188C3.891 2.188 0 5.478 0 9.53c0 2.212 1.17 4.203 3.002 5.55a.59.59 0 0 1 .213.665l-.534 1.968c-.067.247.195.46.417.34l2.42-1.309a.62.62 0 0 1 .49-.044c.854.244 1.758.376 2.683.376.377 0 .747-.023 1.11-.067a6.29 6.29 0 0 1-.21-1.614c0-3.754 3.655-6.797 8.163-6.797.35 0 .695.02 1.034.057C17.784 5.378 13.619 2.188 8.691 2.188zm-2.457 4.14c.677 0 1.226.549 1.226 1.226s-.549 1.226-1.226 1.226a1.227 1.227 0 0 1-1.226-1.226c0-.677.549-1.226 1.226-1.226zm4.914 0c.677 0 1.226.549 1.226 1.226s-.549 1.226-1.226 1.226a1.227 1.227 0 0 1-1.226-1.226c0-.677.549-1.226 1.226-1.226zm4.643 3.82c-3.957 0-7.164 2.668-7.164 5.96 0 1.798.954 3.418 2.443 4.515.228.168.324.469.245.742l-.434 1.599c-.054.202.16.375.34.278l1.968-1.064a.5.5 0 0 1 .4-.035c.694.198 1.429.305 2.179.305 3.957 0 7.164-2.668 7.164-5.96 0-3.292-3.207-5.94-7.14-5.94zm-2.003 3.372c.551 0 .998.447.998.998 0 .551-.447.998-.998.998a.999.999 0 0 1-.998-.998c0-.551.447-.998.998-.998zm4.007 0c.551 0 .998.447.998.998 0 .551-.447.998-.998.998a.999.999 0 0 1-.998-.998c0-.551.447-.998.998-.998z" />',
};
---

<svg
  class:list={["icon", sizeClasses[size], className, { "icon--filled": filled, "icon--heavy": stroke }]}
  viewBox="0 0 24 24"
  fill={filled ? "currentColor" : "none"}
  stroke={filled ? "none" : "currentColor"}
  aria-hidden="true"
  focusable="false"
  set:html={paths[name]}
  {...attributes}
/>

<style>
  /* The shared `.icon` rule declares `fill: none` and a stroke width, so a
     filled mark has to undo both: presentation attributes lose to CSS, and
     leaving the stroke on would outline the shape as well as fill it. */
  .icon--filled {
    fill: currentColor;
    stroke: none;
  }

  /* Sizes, so a caller picks one instead of writing its own width/height pair
     against the base 1.15rem. */
  .icon--xs {
    width: 0.9rem;
    height: 0.9rem;
  }

  .icon--sm {
    width: 1.25rem;
    height: 1.25rem;
  }

  .icon--lg {
    width: 1.45rem;
    height: 1.45rem;
  }

  .icon--xl {
    width: 1.65rem;
    height: 1.65rem;
  }

  .icon--heavy {
    stroke-width: 2;
  }
</style>
