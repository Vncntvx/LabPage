---
/**
 * The site's icon set. Every glyph shares one 24×24 stroked frame so a caller
 * cannot accidentally mix optical weights; the header, the theme toggle, the
 * language switcher and the social links all render from here.
 *
 * Icons are decorative — the control that owns an icon carries the accessible
 * name — so each is hidden from assistive technology and unfocusable.
 */
export type IconName =
  | "menu"
  | "close"
  | "search"
  | "globe"
  | "sun"
  | "moon"
  | "github"
  | "orcid"
  | "researchgate"
  | "scholar"
  | "wechat"
  | "mail"
  | "calendar"
  | "document"
  | "rss"
  | "chevron";

interface Props {
  name: IconName;
  /** Brand marks that read better as filled shapes than as strokes. */
  filled?: boolean;
  /** Square edge length. The six sizes the site used by hand, named. */
  size?: "xs" | "sm" | "md" | "lg" | "xl";
  /** Heavier stroke, for glyphs that carry more visual weight at a large size. */
  stroke?: boolean;
  class?: string;
  /** Forwarded so a caller can key an icon off state, e.g. `data-theme-icon`. */
  [key: `data-${string}`]: unknown;
}

const { name, filled = false, size = "md", stroke = false, class: className, ...attributes } = Astro.props;

/**
 * The base `.icon` rule carries the default 1.15rem, so `md` needs no class —
 * only the sizes that differ from it do. The names are ordered by size; `sm`
 * and `lg` bracket the base the way a type scale would.
 */
const sizeClasses: Record<NonNullable<Props["size"]>, string | undefined> = {
  xs: "icon--xs",
  sm: "icon--sm",
  md: undefined,
  lg: "icon--lg",
  xl: "icon--xl",
};

/**
 * UI glyphs are drawn on the 24×24 grid above. Brand marks are the real thing:
 * a recognisable logo drawn approximately is worse than no logo, so these keep
 * their official geometry and are drawn filled.
 */
const paths: Record<IconName, string> = {
  menu: '<path d="M6 6h12M6 12h12M6 18h12" />',
  close: '<path d="M6 6l12 12M18 6 6 18" />',
  search: '<circle cx="10.5" cy="10.5" r="6.5" /><path d="m16 16 5 5" />',
  globe: '<circle cx="12" cy="12" r="9" /><path d="M3 12h18" /><path d="M12 3a14 14 0 0 1 0 18" /><path d="M12 3a14 14 0 0 0 0 18" />',
  sun: '<circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />',
  moon: '<path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8" />',
  mail: '<rect x="3" y="5" width="18" height="14" rx="2" /><path d="m3 7 9 6 9-6" />',
  calendar: '<rect x="3" y="5" width="18" height="16" rx="2" /><path d="M3 10h18M8 3v4M16 3v4" />',
  document:
    '<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" /><polyline points="14 2 14 8 20 8" /><line x1="16" y1="13" x2="8" y2="13" /><line x1="16" y1="17" x2="8" y2="17" />',
  rss: '<path d="M4 11a9 9 0 0 1 9 9" /><path d="M4 4a16 16 0 0 1 16 16" /><circle cx="5" cy="19" r="1.5" fill="currentColor" stroke="none" />',
  chevron: '<path d="m6 9 6 6 6-6" />',

  // ── Brand marks ──────────────────────────────────────────────────────────
  github:
    '<path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0 1 12 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0 0 22 12.017C22 6.484 17.522 2 12 2z" />',
  orcid:
    '<path d="M12 0C5.372 0 0 5.372 0 12s5.372 12 12 12 12-5.372 12-12S18.628 0 12 0zM7.369 4.378c.525 0 .947.431.947.947s-.422.947-.947.947a.95.95 0 0 1-.947-.947c0-.525.422-.947.947-.947zm-.722 3.038h1.444v10.041H6.647V7.416zm3.562 0h3.9c3.712 0 5.344 2.653 5.344 5.025 0 2.578-2.016 5.016-5.325 5.016h-3.919V7.416zm1.444 1.303v7.444h2.297c2.359 0 3.844-1.519 3.844-3.712 0-2.062-1.397-3.731-3.791-3.731h-2.35z" />',
