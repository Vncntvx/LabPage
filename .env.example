# 阿里云 OSS 配置（仅用于本地脚本增量上传与同步，请勿将含真实密钥的 .env 提交到 Git）
OSS_REGION=oss-cn-hangzhou
OSS_ACCESS_KEY_ID=your_access_key_id
OSS_ACCESS_KEY_SECRET=your_access_key_secret
OSS_BUCKET=wenjie-lab-assets

# OSS 存储根路径前缀（如果 Bucket 同时作为图床使用，可设置子目录隔离，如 lab 或 site）
# 对应存储路径为: oss://<bucket>/<OSS_ROOT_PREFIX>/assets/...
# 留空表示直接存放在 Bucket 根目录下
OSS_ROOT_PREFIX=lab

# 可选：覆盖 src/data/oss-sync.json 中的远程 Base URL（例如配置了自定义 CDN 域名）
# PUBLIC_ASSETS_BASE_URL=http://oss.wenjiexu.site
